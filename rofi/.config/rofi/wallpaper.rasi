@import "~/.config/rofi/config.rasi"

/* ---- Configuration ---- */
configuration {
    show-icons: true;
    icon-fetcher: "internal";
}

/* ---- Window ---- */
window {
    width: 50%;
    height: 28%;
    border-radius: 20px;
}

/* ---- Mainbox ---- */
mainbox {
    children: ["inputbar", "listview"];
}

/* ---- Inputbar ---- */
inputbar {
    enabled: true;
    children: ["prompt", "entry"];
    background-color: transparent;
}

prompt {
    enabled: true;
    padding: 0px 10px 0px 0px;
    background-color: transparent;
    text-color: inherit;
}

entry {
    placeholder: "󰍉 Search...";
    background-color: transparent;
    text-color: inherit; 
}

/* ---- Listview ---- */
listview {
    fixed-height: false;
    scrollbar: false;
    cycle: false;
    dynamic: true;
    layout: horizontal;
    reverse: false;
}

/* ---- Elements ---- */
element {
    orientation: horizontal;
    border-radius: 12px;
}

element normal.normal {
    background-color: transparent;
    text-color: inherit;
}

element selected.normal {
    background-color: @selected-normal-background;
}

element-icon {
    size: 10em;
    horizontal-align: 0.5;
    vertical-align: 0.5;
}

element-text {
    enabled: false;
}
