output eDP-1 {
    mode 1920x1080@60Hz
    scale 1
    position 0,0
}

output "Microstep MSI G241 0x00000026" {
    mode 1920x1080@144Hz
    scale 1
    position 0,0
}

profile laptop {
    output eDP-1 enable
}

profile docked {
    output eDP-1 disable
    output "Microstep MSI G241 0x00000026" enable
}
