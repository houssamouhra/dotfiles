# Laptop only
profile undocked {
    output eDP-1 enable
    exec sh -c 'ln -sf ~/.config/hypr/monitors/hyprlock-laptop.conf ~/.config/hypr/hyprlock.conf'
}

# external monitor connected
profile docked {
    output eDP-1 disable
    output HDMI-A-1 enable mode 1920x1080@144
    exec sh -c 'ln -sf ~/.config/hypr/monitors/hyprlock-external.conf ~/.config/hypr/hyprlock.conf'
}
