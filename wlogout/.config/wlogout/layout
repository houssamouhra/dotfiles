{
    "label" : "lock",
    "action" : "hyprlock",
    "keybind" : "l"
}
{
    "label" : "reboot",
    "action" : "systemctl reboot",
    "keybind" : "r"
}
{
    "label" : "shutdown",
    "action" : "systemctl poweroff",
    "keybind" : "q"
}
{
    "label" : "logout",
    "action" : "hyprctl dispatch exit 0",
    "keybind" : "e"
}
{
    "label" : "sleep",
    "action" : "~/.config/wlogout/scripts/sleep.sh"
    "keybind" : "s"
}
