{
    "label" : "lock",
    "action" : "hyprlock",
    "keybind" : "l"
}
{
    "label" : "reboot",
    "action" : "systemctl reboot || loginctl reboot",
    "keybind" : "r"
}

{
    "label" : "sleep",
    "action" : "~/.config/wlogout/scripts/sleep.sh",
    "keybind" : "s"
}
{
    "label" : "shutdown",
    "action" : "systemctl poweroff || loginctl poweroff",
    "keybind" : "q"
}
