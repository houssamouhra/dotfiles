# This is Git's per-user configuration file.
[user]
  email = houssamblur04@gmail.com
  name = Houssam Ouhra

[core]
  editor = nvim
  autocrlf = input
  pager = delta
  safecrlf = true

[diff]
  tool = nvimdiff
  colorMoved = default

[difftool "nvimdiff"]
  cmd = "nvim -d \"$LOCAL\" \"$REMOTE\"" 

[commit]
  verbose = true

[alias]
  lg = log --pretty=format:'%C(yellow)%h%Creset %C(blue)%an%Creset %s %Cgreen(%cr)%Creset'
  unstage = restore --staged .
  graph = log --oneline --graph --decorate --all --date-order
  pr = pull --rebase
  ds = diff --staged
  ap = add -p

[filter "lfs"]
  clean = git-lfs clean -- %f
  smudge = git-lfs smudge -- %f
  process = git-lfs filter-process
  required = true

[interactive]
  diffFilter = delta --color-only

[include]
  path = ~/.config/delta/themes.gitconfig

[delta]
  features = weeping-willow 
  syntax-theme = OneHalfDark 
  side-by-side = true
  line-numbers = true
  navigate = true

[merge]
  conflictStyle = zdiff3

[color]
  ui = auto

[pager]
  log = delta

[safe]
  directory = ~/dotfiles

[credential]
  helper = store

[init]
  defaultBranch = main
