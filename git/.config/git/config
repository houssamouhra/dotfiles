# This is Git's per-user configuration file.
[user]
  email = houssamblur04@gmail.com
  name = Houssam Ouhra

[core]
  editor = nvim
  autocrlf = input
  pager = delta
  safecrlf = true
  whitespace = error
  preloadindex = true

[diff]
  context = 3
  tool = nvimdiff
  colorMoved = default

[difftool "nvimdiff"]
  cmd = "nvim -d \"$LOCAL\" \"$REMOTE\""

[commit]
  verbose = true

[alias]
  graph = log --all --graph --pretty=format:'%C(yellow)%h%Creset %C(blue)%an%Creset %C(green)(%ar)%Creset %C(auto)%d%Creset%n    %s%n'
  lg = log --oneline --graph --decorate --all --date-order --color
  unstage = restore --staged
  amend = commit --amend --no-edit
  pr = pull --rebase
  ds = diff --staged
  ap = add -p

[filter "lfs"]
  clean = git-lfs clean -- %f
  smudge = git-lfs smudge -- %f
  process = git-lfs filter-process
  required = true

[interactive]
  diffFilter = delta --color-only
  singlekey = true

[include]
  path = ~/.config/delta/themes.gitconfig

[delta]
  features = colibri
  syntax-theme = tokyonight_night
  side-by-side = false
  line-numbers = true
  navigate = true

[merge]
  conflictStyle = zdiff3

[color]
  ui = true

[pager]
  log = delta

[safe]
  directory = ~/dotfiles

[credential]
  helper = libsecret

[init]
  defaultBranch = main

[i18n]
  commitEncoding = utf-8
  logOutputEncoding = utf-8
