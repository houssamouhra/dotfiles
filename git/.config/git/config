# This is Git's per-user configuration file.
[user]
  email = 149302326+houssamouhra@users.noreply.github.com
  name = Houssam Ouhra

[core]
  editor = nvim
  autocrlf = input
  pager = delta
  safecrlf = true
  whitespace = error
  preloadindex = true

[diff]
  context = 3
  tool = nvimdiff
  colorMoved = default

[difftool "nvimdiff"]
  cmd = "nvim -d \"$LOCAL\" \"$REMOTE\""

[commit]
  verbose = true

[alias]
  graph = log --all --graph --pretty=format:'%C(yellow)%h%Creset %C(blue)%an%Creset %C(green)(%ar)%Creset %C(auto)%d%Creset%n    %s%n'
  lg = log --oneline --graph --decorate --all --date-order --color
  unstage = restore --staged
  amend = commit --amend --no-edit
  pr = pull --rebase
  ap = add -p
  sh = show --patch --stat

[filter "lfs"]
  clean = git-lfs clean -- %f
  smudge = git-lfs smudge -- %f
  process = git-lfs filter-process
  required = true

[interactive]
  diffFilter = delta --color-only
  singlekey = true

[delta]
  dark = true
  navigate = true
  syntax-theme = none
  true-color = always
  side-by-side = false
  line-numbers = false
  zero-style = dim
  hyperlinks = true
  file-added-label = [+]
  file-copied-label = [*]
  file-modified-label = [~]
  file-removed-label = [-]
  file-renamed-label = [>]
  keep-plus-minus-markers = true
  file-style = "#9aa5ce" bold
  file-decoration-style = "#414868" ul
  hunk-header-decoration-style = none
  hunk-header-file-style = "#7d89b5"
  hunk-header-line-number-style = "#565f89"
  hunk-header-style = file line-number "#7d89b5"
  minus-style = normal "#332129"
  minus-emph-style = normal "#4d2230"
  plus-style  = syntax "#21342d"
  plus-emph-style = syntax bold "#1f463c"
  whitespace-error-style = "#f7768e" underline
  blame-format = "{author:<18} {commit:<6} {timestamp:<15}"
  blame-palette = "#252c3a #2d2a24 #2b2936 #263130 #2a3028 #313645 #292e3d #303544"

[merge]
  conflictStyle = zdiff3

[color]
  ui = true

[pager]
  log = delta

[safe]
  directory = ~/dotfiles

[show]
  stat = true

[credential]
  helper = libsecret

[init]
  defaultBranch = main

[i18n]
  commitEncoding = utf-8
  logOutputEncoding = utf-8
