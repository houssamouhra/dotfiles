font=Maple Mono NF 12
background-color=#16161ecc
text-color=#c0caf5
width=350
padding=15
margin=5
border-radius=10
border-size=0
anchor=top-right
layer=overlay
icons=1
max-icon-size=60
icon-location=left
markup=1
format=<b>%s</b>\n%b
text-alignment=left
icon-path=/usr/share/icons/Adwaita

[urgency=low]
background-color=#16161ecc
text-color=#c0caf5
default-timeout=3000

[urgency=normal]
background-color=#16161ecc
text-color=#c0caf5
default-timeout=4000

[urgency=critical]
background-color=#16161e
text-color=#c0caf5
border-color=#f7768e
default-timeout=8000
