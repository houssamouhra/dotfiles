    "sourceCode": "/* ==UserStyle==\n@name         Prettier GitHub\n@namespace    USO Archive\n@author       fun840 .\n@description  A pretty styling for GitHu\n@version      0.0.1\n@license      NONE\n@preprocessor uso\n==/UserStyle== */\n@-moz-document domain(\"github.com\") {\n\n    * {\n        /* not variables */\n        font-family: \"JetBrainsMono Nerd Font\", mono;\n    }\n\n    .Box,\n    .Box-Body {\n        border-radius: 15px;\n    }\n    .Box-header {\n        border-radius: 15px 15px 0px 0px;\n    }\n\n    .Details-content--hidden-not-important.js-navigation-container {\n        border-radius: 0px 0px 15px 15px;\n    }\n\n    .UnderlineNav-item,\n    .UnderlineNav-octicon {\n        color: #787C99;\n    }\n\n\n    /* markdown */\n    .markdown-body h1,\n    .markdown-body h2 {\n        border-bottom: 1px solid #585B74 !important;\n    }\n\n\n    /* tag text */\n    .State {\n        color: var(--color-canvas-default);\n    }\n\n    /* octicons */\n    .footer-octicon {\n        color: #787C99;\n    }\n    .footer-octicon:hover {\n        color: #9397AE;\n    }\n    .octicon-eye {\n        fill: #BB9AF7;\n    }\n    .octicon-eye:hover {\n        transform: scale(1.1);\n    }\n    .octicon-star {\n        fill: #E0AF68;\n    }\n    .octicon-star:hover {\n        transform: scale(1.1);\n    }\n    .octicon-repo-forked {\n        fill: #73DACA;\n    }\n    .octicon-repo-forked:hover {\n        transform: scale(1.1);\n    }\n    .octicon-check {\n        fill: #9ECE6A;\n    }\n    .octicon-git-branch {\n        fill: #7BC5E4;\n    }\n    .octicon-tag {\n        fill: #E0AF68;\n    }\n    .octicon-tag.color-fg-success {\n        fill: var(--color-success-fg);\n    }\n    .octicon-history {\n        fill: #7AA2F7;\n    }\n    .octicon-issue-opened.open,\n    .octicon-git-pull-request.open {\n        fill: #9ECE6A;\n    }\n    .octicon-git-merge.open,\n    .octicon-issue-closed {\n        fill: #BB9AF7;\n    }\n    .octicon-git-pull-request-closed {\n        fill: #F7768E;\n    }\n    .State .octicon-issue-closed {\n        fill: var(--color-fg-on-emphasis) !important;\n    }\n}\n\n@-moz-document regexp(\"https?://.*github.com/.+\") {}",
