#!/usr/bin/env bash

shopt -s nullglob

# Find the highest existing 4-digit filename
max=0

for f in *.{jpg,jpeg,png}; do
	[[ -e $f ]] || continue

	base="${f%.*}"

	if [[ $base =~ ^([0-9]{4})$ ]]; then
		((num = 10#${BASH_REMATCH[1]}))
		((num > max)) && max=$num
	fi
done

# Rename only files that are NOT already numbered
next=$((max + 1))

for f in *.{jpg,jpeg,png}; do
	[[ -e $f ]] || continue

	base="${f%.*}"

	# Skip already numbered files
	[[ $base =~ ^[0-9]{4}$ ]] && continue

	ext="${f##*.}"
	new="$(printf "%04d.%s" "$next" "$ext")"

	# Prevent accidental overwrite
	if [[ -e $new ]]; then
		printf 'Error: "%s" already exists. Aborting.\n' "$new" >&2
		exit 1
	fi

	printf 'Renaming "%s" -> "%s"\n' "$f" "$new"
	mv -- "$f" "$new"

	((next++))
done
