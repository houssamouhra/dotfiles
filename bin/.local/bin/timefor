#!/usr/bin/env bash

set -euo pipefail
CATEGORIES=(WORK NVIM WASTE STOP)
BLOCKED_DOMAINS=(
	"www.youtube.com"
	"www.reddit.com"
	"www.x.com"
	"www.linkedin.com"
)

# --- UI ---
select_category() {
	printf "%s\n" "${CATEGORIES[@]}" | fzf --bind 'q:abort'
}

# --- TMUX ---
update_tmux_status() {
	[[ -z "${TMUX:-}" ]] && return
	local category="$1"
	local total=""
	[[ "$category" == "STOP" ]] || total=$(timew | awk '/^ *Total/ {print $NF}')
	tmux set -g @time_category "$category"
	tmux set -g @time_total "$total"
}

# --- SUDO (cache once) ---
ensure_sudo() {
	sudo -n true 2>/dev/null || sudo -v
}

# --- SITE CONTROL ---
toggle_sites() {
	local action="$1" # add | rm
	for domain in "${BLOCKED_DOMAINS[@]}"; do
		sudo hostess "$action" "$domain" 127.0.0.1 >/dev/null 2>&1 || true
	done
}

block_sites() { toggle_sites add; }
unblock_sites() { toggle_sites rm; }

# --- TIMEW ---
start_tracking() {
	timew stop >/dev/null 2>&1 || true
	[[ "$1" != "STOP" ]] && timew start "$1" >/dev/null 2>&1
}

# --- MAIN ---
main() {
	local selected
	selected=$(select_category) || exit 0

	ensure_sudo

	case "$selected" in
	STOP)
		start_tracking "STOP"
		update_tmux_status "STOP"
		unblock_sites
		;;
	WASTE)
		start_tracking "$selected"
		update_tmux_status "$selected"
		unblock_sites
		;;
	WORK | NVIM)
		start_tracking "$selected"
		update_tmux_status "$selected"
		block_sites
		;;
	esac
}

main "$@"
